# Sao chép file này thành ".env" rồi điền giá trị.

# API key Gemini: tạo miễn phí tại https://aistudio.google.com/apikey
# (đăng nhập bằng tài khoản Google của bạn trên trình duyệt, KHÔNG ghi mật khẩu vào đây)
# Không bật thanh toán (billing) thì không bao giờ bị tính tiền, hết hạn mức chỉ báo lỗi.
GEMINI_API_KEY=

# Model dùng để phân tích (có trong gói miễn phí). Alias -latest tự lên bản mới nhất
GEMINI_MODEL=gemini-flash-latest
# Model dự phòng khi model chính bị quá tải (lỗi 503)
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# 1 = tự động phân tích AI toàn bộ danh mục khi quét định kỳ, 0 = chỉ khi bấm nút
GEMINI_AUTO_SCAN=0
# Khi tự động: chỉ gọi lại AI cho mỗi mã sau ít nhất bấy nhiêu giờ
GEMINI_AUTO_HOURS=4

# Cổng web và chu kỳ quét danh mục (phút)
PORT=3000
SCAN_MINUTES=10

# ===== Nhà cung cấp AI dự phòng (tự chuyển khi Gemini hết hạn mức) =====
# Thứ tự thử: các key Gemini → Mistral → Groq → OpenRouter → tùy chỉnh. Đổi thứ tự (tùy chọn):
# AI_PROVIDERS=gemini,mistral,groq,openrouter,custom

# Thêm key Gemini từ PROJECT KHÁC (hạn mức tính theo project), cách nhau bằng dấu phẩy
GEMINI_API_KEYS=

# Mistral (miễn phí gói Experiment): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Groq (miễn phí, rất nhanh): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (model đuôi :free miễn phí): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Có thể ghi nhiều model cách nhau dấu phẩy, OpenRouter tự thử model kế tiếp
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free,qwen/qwen3-235b-a22b:free,openai/gpt-oss-120b:free

# Bất kỳ dịch vụ chuẩn OpenAI nào khác (Cerebras, DeepSeek, OpenAI, Ollama chạy trên máy…)
CUSTOM_AI_NAME=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# Tiêu chí chọn cổ phiếu cho Cổ phiếu tiềm năng và Bảng xếp hạng
# Sàn được xét (có thể ghi nhiều sàn: HOSE,HNX,UPCOM)
SCREEN_FLOORS=HOSE
# Giá trị khớp lệnh trung bình 20 phiên tối thiểu (đồng): 5 tỷ
SCREEN_MIN_VALUE=5000000000
